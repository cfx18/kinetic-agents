# Copy to .env.network, chmod 600; never source this file.
# Only the trusted host reads this file. URLs may contain proxy credentials.
# File values REPLACE the shell's routing/CA variables. Empty means unset.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
SSL_CERT_FILE=
SSL_CERT_DIR=
CODEX_CA_CERTIFICATE=
